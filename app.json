{
  "expo": {
    "name": "Pawka",
    "slug": "pawka_front",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/LogoAndroid.png",
    "scheme": "pawkafront",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFDDCFF",
        "foregroundImage": "./assets/images/LogoAndroid.png"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "pawka.com"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon-pawka.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Nous avons besoin d'accéder à votre caméra pour scanner des codes-barres.",
          "microphonePermission": "Nous avons besoin d'accéder au microphone si l'enregistrement vidéo est utilisé."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d9b1d736-8719-434d-a5d4-be27aeb7cb06"
      }
    }
  }
}
